# FinSight AI Agent — 환경 변수 예시
# cp .env.example .env 후 실제 값을 채워주세요.

# ========================
# OpenAI
# ========================
OPENAI_API_KEY=sk-...

# ========================
# Supabase
# ========================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ========================
# FastAPI 내부 인증 (Next.js ↔ FastAPI 공유 키)
# ========================
INTERNAL_API_KEY=your-internal-api-key

# ========================
# ChromaDB (로컬: localhost:8001, EC2 배포 시 SSH 터널 후 동일)
# ========================
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ========================
# FastAPI 서버 URL (Next.js → FastAPI)
# 로컬: http://localhost:8000
# EC2:  http://your-ec2-public-ip:8000
# ========================
FASTAPI_URL=http://localhost:8000

# ========================
# 데이터 파이프라인 API 키
# ========================
DART_API_KEY=your_dart_api_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NEWS_API_KEY=your_newsapi_key

# ========================
# EC2 배포 (GitHub Actions Secrets에도 등록 필요)
# ========================
# EC2_HOST=your-ec2-public-ip
# EC2_SSH_KEY=base64-encoded-pem-key

# ========================
# 알림 (선택)
# ========================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
