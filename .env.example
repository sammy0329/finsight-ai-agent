# ========================
# MySQL (로컬 Docker: 3307, 프로덕션 RDS: 3306)
# ========================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=finsight
MYSQL_USER=finsight_user
MYSQL_PASSWORD=finsight_password

# ========================
# Spring Boot
# ========================
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
INTERNAL_API_KEY=your_internal_api_key_shared_with_fastapi

# ========================
# FastAPI / OpenAI
# ========================
OPENAI_API_KEY=sk-...

# ========================
# Data Pipeline (GitHub Actions Secrets)
# ========================
DART_API_KEY=your_dart_api_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NEWS_API_KEY=your_newsapi_key

# ========================
# 알림 (선택)
# ========================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
