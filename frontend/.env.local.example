# FinSight Frontend — 환경 변수 예시 (Next.js)
# cp frontend/.env.local.example frontend/.env.local 후 실제 값 입력.
# FastAPI 서버 환경 변수는 루트 .env.example 참고.

# ========================
# Supabase (클라이언트 공개 키)
# ========================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ========================
# Supabase (서버사이드 전용 — API Route에서 service role 작업 시 사용)
# ========================
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ========================
# FastAPI 서버 URL (서버사이드 전용 — 클라이언트에 노출되지 않음)
# 로컬 개발: http://localhost:8000
# EC2 배포:  http://your-ec2-elastic-ip:8000
# ========================
FASTAPI_URL=http://localhost:8000

# ========================
# 내부 인증 키 (Next.js API Route → FastAPI 호출 시 사용)
# 루트 .env 의 INTERNAL_API_KEY 와 동일한 값
# ========================
INTERNAL_API_KEY=your-internal-api-key
